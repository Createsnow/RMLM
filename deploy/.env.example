MYSQL_ROOT_PASSWORD=请修改
# 应用连库用的密码（compose 里 DB_HOST=db、DB_NAME/DB_USER=rmlm 已固定）
MYSQL_PASSWORD=请修改
RMLM_JWT_SECRET=请改成一串随机字符（至少 16 位，仍是这句话或过短会拒绝启动）
RMLM_ADMIN_USER=admin
RMLM_ADMIN_PASSWORD=请修改（首次登录后还会强制修改）
# 密码连续输错多少次锁定账号、锁定多少分钟（管理员重置密码可提前解锁）
RMLM_LOGIN_MAX_FAILS=5
RMLM_LOGIN_LOCK_MINUTES=15
# 开单数量允许超出申请数量的比例（%）：0 = 不允许超出；如光缆裁长常略多于申请，可设 5 或 10
RMLM_OVER_ISSUE_PCT=0

# 对外访问地址（企微消息里的链接、网页授权回调都用它；必须是企微后台配置的可信域名），例如 https://rmlm.example.com
RMLM_PUBLIC_URL=

# ---------------- 金蝶云星空 WebAPI（只读；不填则物料用 Excel 导入）----------------
# 密钥只写在 .env，不要提交到仓库。服务器须能访问金蝶内网地址。
K3_SERVER_URL=
K3_ACCT_ID=
K3_USERNAME=
K3_APP_ID=
K3_APP_SECRET=
K3_LCID=2052
# 使用组织编码：同一物料按使用组织各有一行，只同步这个组织的（100 = 深圳爱德泰）
K3_USE_ORG=100
# 研发领料在金蝶其他出库单里的单据类型（名称或编码，逗号分隔）
K3_LL_BILL_TYPES=研发测试其他出库单,客供领料其他出库单
# 登录 / 查询 / 查看单据的超时（秒）；分页查询失败重试次数与间隔（秒）
K3_LOGIN_TIMEOUT=30
K3_QUERY_TIMEOUT=120
K3_VIEW_TIMEOUT=60
K3_PAGE_RETRIES=3
K3_PAGE_RETRY_SECONDS=10

# ---------------- 企业微信自建应用（不填则用账号密码登录、消息只在站内待办）----------------
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret：网页授权登录、发送应用消息
WECOM_SECRET=
# 通讯录同步 Secret（只读）：同步人员、职务、直属上级；不填则用应用 Secret
WECOM_CONTACT_SECRET=
# 同步哪个部门及其下级（1 = 根部门）
WECOM_ROOT_DEPT=1

# ---------------- 仓储系统（实物条码由仓储赋码；接口见 docs/仓储接口规范.md）----------------
# 地址和令牌都填才启用；令牌只写在 .env。不填则本系统发 RM 临时码（仅供开发、测试、演示）
WMS_BASE_URL=
WMS_TOKEN=
WMS_TIMEOUT=10
