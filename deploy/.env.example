# =====================================================================
# 研发物料管家 RMLM · Docker 部署配置（deploy/docker-compose.yml）
# 复制为 deploy/.env 后修改：cp .env.example .env。改完 docker compose up -d 生效。
#
# 分四类，从上往下看：
#   一、【必填】      不填 docker compose 直接报错，起不来
#   二、【上线必改】  不改也能起，但不安全
#   三、【业务参数】  有默认值，按业务需要再改
#   四、【可选对接】  金蝶 / 企业微信 / 仓储，不填就自动降级，系统照常可用
# 数据库地址、库名、账号已在 compose 里固定（DB_HOST=db、DB_NAME / DB_USER=rmlm），这里不用填
# =====================================================================


# =====================================================================
# 一、【必填】不填 docker compose 直接报错
# =====================================================================

# MySQL root 密码（MySQL 随应用一起启动，不用另装）
MYSQL_ROOT_PASSWORD=请修改
# 应用连库用的密码
MYSQL_PASSWORD=请修改
# 登录令牌签名密钥：至少 16 位随机字符，仍是这句话或过短会拒绝启动
#   生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
RMLM_JWT_SECRET=请改成一串随机字符（至少 16 位，仍是这句话或过短会拒绝启动）
# 首个管理员的初始密码（系统不强制改密码，登录后可在“修改密码”里自行修改）
RMLM_ADMIN_PASSWORD=请修改


# =====================================================================
# 二、【上线必改】
# =====================================================================

# 首个管理员账号名（可保持 admin）
RMLM_ADMIN_USER=admin
# 另外：前面须加 HTTPS 反向代理；照片卷 photos 与数据库卷 mysql 须纳入备份（deploy/backup.sh）


# =====================================================================
# 三、【业务参数】有默认值，按需要再改
# =====================================================================

# 开单数量允许超出申请数量的比例（%）：0 = 不允许超出；如光缆裁长常略多于申请，可设 5 或 10
RMLM_OVER_ISSUE_PCT=0


# =====================================================================
# 四、【可选对接】不填就自动降级，系统照常可用
# 密钥只写在 .env，不要提交到仓库
# =====================================================================

# ---------- 4.1 金蝶云星空 WebAPI（只读，不回写金蝶）----------
# 启用条件：下面【连接】五项全部填写。容器须能访问金蝶内网地址
# 不填时：物料、单据用 Excel 导入或手工录入，不会自动拉领料单生成领用行
# 【连接】服务器地址形如 http://金蝶服务器IP/k3cloud/
K3_SERVER_URL=
K3_ACCT_ID=
K3_USERNAME=
K3_APP_ID=
K3_APP_SECRET=
# 【参数，有默认值】语言（2052 = 简体中文）
K3_LCID=2052
# 使用组织编码：同一物料按使用组织各有一行，只同步这个组织的（100 = 深圳爱德泰）
K3_USE_ORG=100
# 研发领料在金蝶其他出库单里的单据类型（名称或编码，逗号分隔）；只自动拉这些类型
K3_LL_BILL_TYPES=研发测试其他出库单,客供领料其他出库单
# 领料单首次同步的起始日期：首次启动（还没有同步记录）和手动"全量同步"时，只拉修改日期在此之后的单据，不拉全部历史；
# 之后按网页「ERP 单据 → 自动同步设置」的间隔（默认每 15 分钟）从上次同步到的时间点增量拉取，不受此限制。
# 填固定日期（YYYY-MM-DD）优先；不填则取"今天往前 K3_SYNC_START_MONTHS 个月"（默认 3 个月）
K3_SYNC_START_DATE=
K3_SYNC_START_MONTHS=3
# 登录 / 查询 / 查看单据的超时（秒）；分页查询失败重试次数与间隔（秒）
K3_LOGIN_TIMEOUT=30
K3_QUERY_TIMEOUT=120
K3_VIEW_TIMEOUT=60
K3_PAGE_RETRIES=3
K3_PAGE_RETRY_SECONDS=10

# ---------- 4.2 企业微信自建应用 ----------
# 启用条件：WECOM_CORP_ID、WECOM_AGENT_ID、WECOM_SECRET 三项全部填写。
#   这三项是一个总开关：填齐后下面三个功能同时开启，不能只开其中一个。
# 不填时：只能账号密码登录；待办只在系统内显示，不推送企微；人员和直属上级在“账号管理”里维护。
#
#   功能               用到的配置                                   说明
#   ① 免密登录         三项 + RMLM_PUBLIC_URL                       在企微客户端里打开系统（工作台、消息卡片、聊天里的链接、企微扫一扫）自动登录；
#                                                                   普通浏览器、个人微信仍用账号密码
#   ② 消息推送         三项 + RMLM_PUBLIC_URL                       待办同步推送到本人企微，点开直达对应页面；失败每 15 分钟补发
#   ③ 通讯录同步       三项 + WECOM_CONTACT_SECRET（可空）+ ROOT_DEPT  每天同步人员、职务、直属上级、离职
#
# 【企业与应用】在企微管理后台 → 我的企业 / 应用管理 → 自建应用 里查看
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret：①免密登录、②消息推送用
WECOM_SECRET=
# 【①② 必填】系统对外访问地址，必须是企微后台登记的可信域名（https），例如 https://rmlm.example.com
#   网页授权回调和消息卡片里的链接都用它；企微开启时不填，消息卡片的链接打不开、登录也可能回调失败
RMLM_PUBLIC_URL=
# 【③ 通讯录同步】通讯录同步 Secret（只读）；不填则用上面的应用 Secret（需应用有通讯录读取权限）
WECOM_CONTACT_SECRET=
# 【③ 通讯录同步】同步哪个部门及其下级（1 = 根部门）
WECOM_ROOT_DEPT=1

# ---------- 4.3 仓储系统（实物条码；接口见 docs/仓储接口规范.md）----------
# 一期不对接：两项都留空即可。
# 启用条件：WMS_BASE_URL、WMS_TOKEN 两项都填写。启用后签收须扫仓储条码，拆分向仓储申请新码。容器须能访问仓储地址
# 不填时：本系统发 RM 行码（一期按此运行），签收不扫码，拆分由本系统发新码并打印标签
WMS_BASE_URL=
WMS_TOKEN=
WMS_TIMEOUT=10
