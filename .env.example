# 本地开发配置。python start.py 首次运行时会复制为 .env，按需修改 .env 即可（.env 不提交）。
# 改完重启后端生效。值原样读取（可含 # = @ 等字符，行尾不要写注释）；首尾有空格时用引号包住。

# ---------- 1. 端口与对外地址 ----------
# 监听地址与端口（0.0.0.0 表示局域网内手机也能访问）
RMLM_HOST=0.0.0.0
RMLM_PORT=8000
# 对外访问地址（企微消息里的链接、网页授权回调都用它；必须是企微后台配置的可信域名），例如 https://rmlm.example.com
RMLM_PUBLIC_URL=

# ---------- 2. 安全与登录 ----------
# 登录令牌签名密钥（本地随意，生产环境必须改成随机字符串）
RMLM_JWT_SECRET=dev-secret-change-me
# 首次启动时自动创建的管理员（首次登录会强制改密码）
RMLM_ADMIN_USER=admin
RMLM_ADMIN_PASSWORD=admin123

# ---------- 3. 数据库（MySQL 8）----------
# 换库 / 换账户只改对应一行。库需提前建好（字符集 utf8mb4）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rmlm
DB_USER=rmlm
DB_PASSWORD=rmlm_dev
# 也可以直接写完整连接串，写了就以它为准、忽略上面五项：
# RMLM_DATABASE_URL=mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4

# ---------- 4. 金蝶云星空 WebAPI（只读，不回写金蝶）----------
# 前五项都填上才启用；不填则物料用 Excel 导入。密钥只写在 .env，不要提交到仓库。服务器须能访问金蝶内网地址。
# 服务器地址形如 http://金蝶服务器IP/k3cloud/
K3_SERVER_URL=
K3_ACCT_ID=
K3_APP_ID=
K3_APP_SECRET=
K3_USERNAME=
# 2052 = 简体中文
K3_LCID=2052
# 使用组织编码：同一物料按使用组织各有一行，只同步这个组织的（100 = 深圳爱德泰）
K3_USE_ORG=100
# 登录 / 查询 / 查看单据的超时（秒）
K3_LOGIN_TIMEOUT=30
K3_QUERY_TIMEOUT=120
K3_VIEW_TIMEOUT=60
# 分页查询失败（超时、断连、5xx）时的重试次数与间隔（秒）
K3_PAGE_RETRIES=3
K3_PAGE_RETRY_SECONDS=10

# ---------- 5. 企业微信自建应用（不填则用账号密码登录、消息只在站内待办）----------
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret：网页授权登录、发送应用消息
WECOM_SECRET=
# 通讯录同步 Secret（只读）：同步人员、职务、直属上级；不填则用应用 Secret
WECOM_CONTACT_SECRET=
# 同步哪个部门及其下级（1 = 根部门）
WECOM_ROOT_DEPT=1

# ---------- 6. 定时任务 ----------
# 是否启动定时任务（1 启动 / 0 不启动）
RMLM_SCHEDULER=1
