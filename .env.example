# 本地开发配置。start.py 首次运行时会复制为 .env，按需修改 .env 即可（.env 不提交）。

# MySQL 连接：mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4
RMLM_DATABASE_URL=mysql+pymysql://rmlm:rmlm_dev@127.0.0.1:3306/rmlm?charset=utf8mb4

# 监听地址与端口（0.0.0.0 表示局域网内手机也能访问）
RMLM_HOST=0.0.0.0
RMLM_PORT=8000

# 首次启动时自动创建的管理员（首次登录会强制改密码）
RMLM_ADMIN_USER=admin
RMLM_ADMIN_PASSWORD=admin123

# 登录令牌签名密钥（本地随意，生产环境必须改成随机字符串）
RMLM_JWT_SECRET=dev-secret-change-me

# 是否启动定时任务（1 启动 / 0 不启动）
RMLM_SCHEDULER=1

# 对外访问地址（企微消息里的链接、网页授权回调都用它；必须是企微后台配置的可信域名），例如 https://rmlm.example.com
RMLM_PUBLIC_URL=

# ---------------- 金蝶云星空 WebAPI（只读；不填则物料用 Excel 导入）----------------
# 密钥只写在 .env，不要提交到仓库。服务器须能访问金蝶内网地址。
K3_SERVER_URL=
K3_ACCT_ID=
K3_USERNAME=
K3_APP_ID=
K3_APP_SECRET=
K3_LCID=2052
# 使用组织编码：同一物料按使用组织各有一行，只同步这个组织的（100 = 深圳爱德泰）
K3_USE_ORG=100

# ---------------- 企业微信自建应用（不填则用账号密码登录、消息只在站内待办）----------------
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret：网页授权登录、发送应用消息
WECOM_SECRET=
# 通讯录同步 Secret（只读）：同步人员、职务、直属上级；不填则用应用 Secret
WECOM_CONTACT_SECRET=
# 同步哪个部门及其下级（1 = 根部门）
WECOM_ROOT_DEPT=1
