# 本地开发配置。start.sh / start.bat 首次运行时会复制为 .env，按需修改 .env 即可（.env 不提交）。

# MySQL 连接：mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4
RMLM_DATABASE_URL=mysql+pymysql://rmlm:rmlm_dev@127.0.0.1:3306/rmlm?charset=utf8mb4

# 监听地址与端口（0.0.0.0 表示局域网内手机也能访问）
RMLM_HOST=0.0.0.0
RMLM_PORT=8000

# 首次启动时自动创建的管理员（首次登录会强制改密码）
RMLM_ADMIN_USER=admin
RMLM_ADMIN_PASSWORD=admin123

# 登录令牌签名密钥（本地随意，生产环境必须改成随机字符串）
RMLM_JWT_SECRET=dev-secret-change-me

# 是否启动定时任务（1 启动 / 0 不启动）
RMLM_SCHEDULER=1
