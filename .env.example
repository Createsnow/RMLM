# =====================================================================
# 研发物料管家 RMLM · 本地 / 服务器直接运行的配置（python start.py）
# 首次运行会复制为 .env，只改 .env（.env 不提交到仓库）。改完重启生效。
# 值原样读取（可含 # = @ 等字符，行尾不要写注释）；首尾有空格时用引号包住。
#
# 分四类，从上往下看：
#   一、【必填】      不填或填错，系统起不来
#   二、【上线必改】  不改也能起，但不安全，正式上线前必须改
#   三、【业务参数】  有默认值，按业务需要再改
#   四、【可选对接】  金蝶 / 企业微信 / 仓储，不填就自动降级，系统照常可用
# =====================================================================


# =====================================================================
# 一、【必填】不填或填错，系统起不来
# =====================================================================

# ---------- 1. 数据库（MySQL 8）----------
# 库要提前建好（字符集 utf8mb4），表会在首次启动时自动建。改成你那台 MySQL 的实际值
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rmlm
DB_USER=rmlm
DB_PASSWORD=rmlm_dev
# 也可以直接写完整连接串，写了就以它为准、忽略上面五项：
# RMLM_DATABASE_URL=mysql+pymysql://用户名:密码@地址:端口/库名?charset=utf8mb4

# ---------- 2. 登录令牌签名密钥 ----------
# 至少 16 位随机字符，空、示例值或过短都会拒绝启动。本地留空时 start.py 会自动生成并写回本文件
RMLM_JWT_SECRET=


# =====================================================================
# 二、【上线必改】不改也能起，但正式上线前必须改
# =====================================================================

# 首次启动时自动创建的管理员。系统不强制改密码，正式上线前不要用默认密码，登录后也可在“修改密码”里自行修改
RMLM_ADMIN_USER=admin
RMLM_ADMIN_PASSWORD=admin123


# =====================================================================
# 三、【业务参数】有默认值，按需要再改
# =====================================================================

# ---------- 监听地址与端口（0.0.0.0 表示局域网内手机也能访问）----------
RMLM_HOST=0.0.0.0
RMLM_PORT=8000

# ---------- 账号安全 ----------
# 密码连续输错多少次锁定账号、锁定多少分钟（管理员重置密码可提前解锁）
RMLM_LOGIN_MAX_FAILS=5
RMLM_LOGIN_LOCK_MINUTES=15

# ---------- 开单 ----------
# 开单数量允许超出申请数量的比例（%）：0 = 不允许超出；如光缆裁长常略多于申请，可设 5 或 10
RMLM_OVER_ISSUE_PCT=0

# ---------- 照片 ----------
# 照片保存目录（永久保存，务必纳入备份）。不填时为 backend/data/photos
# RMLM_PHOTO_DIR=
# 照片水印用的中文字体文件。不填时依次尝试：Linux 文泉驿、Windows 微软雅黑 / 黑体、Mac 苹方 / 黑体，都找不到才用不含中文的默认字体。
# 本机中文字体在别的位置时在这里指定，例如 C:/Windows/Fonts/msyh.ttc
# RMLM_WATERMARK_FONT=

# ---------- 定时任务 ----------
# 是否启动定时任务（1 启动 / 0 不启动）。拉金蝶单据、超期巡检、升级、企微推送补发都靠它，正式环境保持 1
RMLM_SCHEDULER=1


# =====================================================================
# 四、【可选对接】不填就自动降级，系统照常可用
# 密钥只写在 .env，不要提交到仓库
# =====================================================================

# ---------- 4.1 金蝶云星空 WebAPI（只读，不回写金蝶）----------
# 启用条件：下面【连接】五项全部填写。服务器须能访问金蝶内网地址
# 不填时：物料、单据用 Excel 导入或手工录入，不会自动拉领料单生成领用行
# 【连接】服务器地址形如 http://金蝶服务器IP/k3cloud/
K3_SERVER_URL=
K3_ACCT_ID=
K3_USERNAME=
K3_APP_ID=
K3_APP_SECRET=
# 【参数，有默认值】语言（2052 = 简体中文）
K3_LCID=2052
# 使用组织编码：同一物料按使用组织各有一行，只同步这个组织的（100 = 深圳爱德泰）
K3_USE_ORG=100
# 研发领料在金蝶其他出库单里的单据类型（名称或编码，逗号分隔）；只自动拉这些类型
K3_LL_BILL_TYPES=研发测试其他出库单,客供领料其他出库单
# 登录 / 查询 / 查看单据的超时（秒）
K3_LOGIN_TIMEOUT=30
K3_QUERY_TIMEOUT=120
K3_VIEW_TIMEOUT=60
# 分页查询失败（超时、断连、5xx）时的重试次数与间隔（秒）
K3_PAGE_RETRIES=3
K3_PAGE_RETRY_SECONDS=10

# ---------- 4.2 企业微信自建应用 ----------
# 启用条件：WECOM_CORP_ID、WECOM_AGENT_ID、WECOM_SECRET 三项全部填写。
#   这三项是一个总开关：填齐后下面三个功能同时开启，不能只开其中一个。
# 不填时：只能账号密码登录；待办只在系统内显示，不推送企微；人员和直属上级在“账号管理”里维护。
#
#   功能               用到的配置                                   说明
#   ① 免密登录         三项 + RMLM_PUBLIC_URL                       在企微客户端里打开系统（工作台、消息卡片、聊天里的链接、企微扫一扫）自动登录；
#                                                                   普通浏览器、个人微信仍用账号密码
#   ② 消息推送         三项 + RMLM_PUBLIC_URL                       待办同步推送到本人企微，点开直达对应页面；失败每 15 分钟补发
#   ③ 通讯录同步       三项 + WECOM_CONTACT_SECRET（可空）+ ROOT_DEPT  每天同步人员、职务、直属上级、离职
#
# 【企业与应用】在企微管理后台 → 我的企业 / 应用管理 → 自建应用 里查看
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用 Secret：①免密登录、②消息推送用
WECOM_SECRET=
# 【①② 必填】系统对外访问地址，必须是企微后台登记的可信域名（https），例如 https://rmlm.example.com
#   网页授权回调和消息卡片里的链接都用它；企微开启时不填，消息卡片的链接打不开、登录也可能回调失败
RMLM_PUBLIC_URL=
# 【③ 通讯录同步】通讯录同步 Secret（只读）；不填则用上面的应用 Secret（需应用有通讯录读取权限）
WECOM_CONTACT_SECRET=
# 【③ 通讯录同步】同步哪个部门及其下级（1 = 根部门）
WECOM_ROOT_DEPT=1

# ---------- 4.3 仓储系统（实物条码；接口见 docs/仓储接口规范.md）----------
# 一期不对接：两项都留空即可。
# 启用条件：WMS_BASE_URL、WMS_TOKEN 两项都填写。启用后签收须扫仓储条码，拆分向仓储申请新码
# 不填时：本系统发 RM 行码（一期按此运行），签收不扫码，拆分由本系统发新码并打印标签
WMS_BASE_URL=
WMS_TOKEN=
# 调用仓储接口的超时（秒）
WMS_TIMEOUT=10
